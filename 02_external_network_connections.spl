index=main sourcetype=XmlWinEventLog:Microsoft-Windows-Sysmon/Operational earliest=-24h
| rex field=_raw "Data Name='Image'>(?<Image>[^<]+)"
| rex field=_raw "Data Name='DestinationIp'>(?<DestinationIp>[^<]+)"
| rex field=_raw "Data Name='DestinationPort'>(?<DestinationPort>[^<]+)"
| rex field=_raw "Data Name='User'>(?<User>[^<]+)"
| rex field=_raw "<EventID>(?<EventID>\d+)</EventID>"
| search EventID=3
| where isnotnull(DestinationIp)
| where NOT (cidrmatch("10.0.0.0/8",DestinationIp) OR cidrmatch("172.16.0.0/12",DestinationIp) OR cidrmatch("192.168.0.0/16",DestinationIp) OR cidrmatch("127.0.0.0/8",DestinationIp) OR cidrmatch("169.254.0.0/16",DestinationIp) OR cidrmatch("224.0.0.0/4",DestinationIp) OR cidrmatch("ff00::/8",DestinationIp))
| stats count as Connections values(DestinationPort) as Ports values(User) as Users by Image DestinationIp
| sort - Connections
